  "devfenix": {
    "prefix": "fenix",
    "body": [
      "{",
      "  inputs = {",
      "    flake-utils.url = \"github:numtide/flake-utils\";",
      "    fenix = {",
      "      url = \"github:nix-community/fenix\";",
      "      inputs.nixpkgs.follows = \"nixpkgs\";",
      "    };",
      "    nixpkgs.url = \"nixpkgs/nixos-unstable\";",
      "  };",
      "",
      "  outputs = { flake-utils, fenix, nixpkgs, ... }:",
      "    let",
      "      nixosModule = { pkgs, ... }: {",
      "        nixpkgs.overlays = [ fenix.overlays.default ];",
      "        environment.systemPackages = [",
      "          (pkgs.fenix.stable.withComponents [",
      "            \"cargo\"",
      "            \"clippy\"",
      "            \"rust-src\"",
      "            \"rustc\"",
      "            \"rustfmt\"",
      "          ])",
      "          pkgs.rust-analyzer",
      "        ];",
      "      };",
      "    in",
      "    flake-utils.lib.eachDefaultSystem (system:",
      "      let",
      "        pkgs = import nixpkgs {",
      "          inherit system;",
      "          overlays = [ fenix.overlays.default ];",
      "        };",
      "        rustToolchain = pkgs.fenix.stable.withComponents [",
      "          \"cargo\"",
      "          \"clippy\"",
      "          \"rust-src\"",
      "          \"rustc\"",
      "          \"rustfmt\"",
      "        ];",
      "      in {",
      "        packages.default = fenix.packages.${system}.stable.toolchain;",
      "        devShells.default = pkgs.mkShell {",
      "          packages = [",
      "            rustToolchain",
      "            pkgs.rust-analyzer",
      "          ];",
      "        };",
      "      }) // {",
      "      nixosConfigurations = {",
      "        nixos = nixpkgs.lib.nixosSystem {",
      "          system = \"x86_64-linux\";",
      "          modules = [ nixosModule ];",
      "        };",
      "",
      "        nixos-aarch64 = nixpkgs.lib.nixosSystem {",
      "          system = \"aarch64-linux\";",
      "          modules = [ nixosModule ];",
      "        };",
      "      };",
      "    };",
      "}"
    ],
    "description": "nix flake for a Fenix-managed Rust toolchain"
  },
  "devnative": {
    "prefix": "native",
    "body": [
      "{",
      "  description = \"Loco Manager\";",
      "  nixConfig = {",
      "    max-jobs = 8;",
      "    cores = 0;",
      "  };",
      "  inputs = {",
      "    nixpkgs.url = \"github:NixOS/nixpkgs/nixos-unstable\";",
      "    fenix = {",
      "      url = \"github:nix-community/fenix\";",
      "      inputs.nixpkgs.follows = \"nixpkgs\";",
      "    };",
      "    naersk = {",
      "      url = \"github:nix-community/naersk\";",
      "      inputs.nixpkgs.follows = \"nixpkgs\";",
      "    };",
      "    flake-utils.url = \"github:numtide/flake-utils\";",
      "  };",
      "  outputs = {",
      "    self,",
      "    nixpkgs,",
      "    fenix,",
      "    naersk,",
      "    flake-utils,",
      "  }:",
      "  flake-utils.lib.eachDefaultSystem (system:",
      "    let",
      "      pkgs = nixpkgs.legacyPackages.${system};",
      "      ",
      "      # Use fenix for Rust toolchain from rust-toolchain.toml",
      "      toolchain = fenix.packages.${system}.fromToolchainFile {",
      "        file = ./rust-toolchain.toml;",
      "        sha256 = \"sha256-qqF33vNuAdU5vua96VKVIwuc43j4EFeEXbjQ6+l4mO4=\";",
      "      };",
      "      # Configure naersk with fenix toolchain",
      "      naersk' = naersk.lib.${system}.override {",
      "        cargo = toolchain;",
      "        rustc = toolchain;",
      "      };",
      "",
      "      # Keep nix build inputs focused on backend sources so unrelated local files",
      "      # do not invalidate Rust builds.",
      "      filteredSrc = pkgs.lib.cleanSourceWith {",
      "        src = ./.;",
      "        filter = path: type:",
      "          let",
      "            rel = pkgs.lib.removePrefix (toString ./. + \"/\") (toString path);",
      "            root = builtins.elemAt (pkgs.lib.splitString \"/\" rel) 0;",
      "            keepRoots = [",
      "              \".cargo\"",
      "              \".github\"",
      "              \"config\"",
      "              \"deploy\"",
      "              \"docs\"",
      "              \"examples\"",
      "              \"migration\"",
      "              \"scripts\"",
      "              \"src\"",
      "              \"tests\"",
      "            ];",
      "            keepFiles = [",
      "              \".gitignore\"",
      "              \".rustfmt.toml\"",
      "              \"Cargo.lock\"",
      "              \"Cargo.toml\"",
      "              \"README.md\"",
      "              \"default.nix\"",
      "              \"flake.lock\"",
      "              \"flake.nix\"",
      "              \"justfile\"",
      "              \"rust-toolchain.toml\"",
      "            ];",
      "          in",
      "          rel == \"\"",
      "          || builtins.elem rel keepFiles",
      "          || builtins.elem root keepRoots;",
      "      };",
      "      # Build the package with naersk",
      "      app = naersk'.buildPackage {",
      "        src = filteredSrc;",
      "        pname = \"myapp\";",
      "        version = \"0.1.0\";",
      "        ",
      "        nativeBuildInputs = with pkgs; [",
      "          pkg-config",
      "          cmake",
      "        ];",
      "        ",
      "        buildInputs = with pkgs; [",
      "          perl",
      "          glib",
      "          openssl",
      "        ];",
      "        ",
      "        # Environment variables for build configuration",
      "        OPENSSL_DIR = \"${pkgs.openssl.dev}\";",
      "        OPENSSL_LIB_DIR = \"${pkgs.openssl.out}/lib\";",
      "        ",
      "        # Don't run tests during build - they may need X server",
      "        doCheck = false;",
      "      };",
      "      ",
      "    in",
      "    {",
      "      packages = {",
      "        default = app;",
      "      };",
      "      ",
      "      devShells.default = pkgs.mkShell {",
      "        nativeBuildInputs = with pkgs; [",
      "          just",
      "          nodejs",
      "          pnpm",
      "          biome",
      "          pm2",
      "          sccache",
      "          cachix",
      "          # Rust toolchain from fenix (includes clippy, rustfmt from rust-toolchain.toml)",
      "          toolchain",
      "          sea-orm-cli",
      "          cmake",
      "          pkg-config",
      "          glib",
      "          openssl",
      "        ];",
      "        ",
      "        shellHook = ''",
      "          export PS1=\"(loco-dev) $PS1\"",
      "          # Set up pkg-config paths",
      "          export PKG_CONFIG_PATH=\"${pkgs.openssl.dev}/lib/pkgconfig:${pkgs.glib.dev}/lib/pkgconfig:$PKG_CONFIG_PATH\"",
      "          # Ensure host glibc path is available for system browser/runtime compatibility",
      "          # export LD_LIBRARY_PATH=\"${pkgs.glib.dev}/lib/:$LD_LIBRARY_PATH\"",
      "          export LD_LIBRARY_PATH=\"\"",
      "          # Set Rust source path",
      "          export RUST_SRC_PATH=\"${toolchain}/lib/rustlib/src/rust/library\"",
      "          export RUSTC_WRAPPER=\"sccache\"",
      "          export SCCACHE_DIR=\"$HOME/.cache/sccache\"",
      "          export SCCACHE_CACHE_SIZE=\"20G\"",
      "        '';",
      "      };",
      "      ",
      "      formatter = pkgs.alejandra;",
      "    }",
      "  );",
      "}"
    ],
    "description": "nix flake for the native loco manager build"
  }
}
