{
  "zellij split window": {
    "title": "zellij split window",
    "filter": "[[ \"$(cat)\" == *edit_in_hx* ]] && echo true || echo false",
    "shell": ["zellij action new-pane --direction=right -- hx ${TM_FILEPATH}"],
    "description": "zellij split and open helix"
  },
  "run main": {
    "title": "cpp run main",
    "filter": "[[ \"$(cat)\" == *main* ]] && echo true || echo false",
    "shell": [
      "zellij action new-pane --cwd ${TM_DIRECTORY} -- sh -c 'g++ -o App ${TM_FILENAME} && ./App'"
    ],
    "description": "go run main"
  }
}
